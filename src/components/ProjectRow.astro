---
import type { Project } from '../data/portfolioData';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div 
  class="project-row group relative w-full -mx-3 px-3 py-2 sm:py-2.5 rounded-lg hover:bg-black/[0.04] dark:hover:bg-white/[0.04] transition-all duration-150 cursor-pointer"
  data-project-id={project.id}
  tabindex="0"
  role="button"
  aria-label={`View details for ${project.title}`}
>
  <div class="flex flex-col space-y-1">
    <!-- Title & Action Arrow -->
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 flex-1 min-w-0">
        <span class="font-mono text-[11px] text-text-muted group-hover:text-text-primary transition-colors flex-shrink-0 select-none">
          {project.number}
        </span>
        <h3 class="text-xs sm:text-[13.5px] font-medium text-text-primary group-hover:text-black dark:group-hover:text-white transition-colors duration-150 truncate">
          {project.title}
        </h3>
      </div>

      <div class="flex items-center flex-shrink-0 text-text-muted group-hover:text-text-primary transition-colors">
        <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-150" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </div>
    </div>

    <!-- Description (1 concise line) -->
    <p class="text-xs text-text-secondary leading-normal truncate pl-[22px]">
      {project.shortDescription}
    </p>

    <!-- Technologies (Monospace list) -->
    <div class="flex items-center gap-1.5 text-[11px] font-mono text-text-muted tracking-tight truncate pl-[22px] select-none">
      {project.technologies.join(" · ")}
    </div>
  </div>
</div>

