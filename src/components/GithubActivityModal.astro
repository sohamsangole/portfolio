---
import { PORTFOLIO_DATA } from '../data/portfolioData';
import { getRecentCommits } from '../utils/getRecentCommits';

const recentCommits = await getRecentCommits();

// Generate mock contribution grid data (52 weeks x 7 days)
const WEEKS = 53;
const DAYS = 7;
const ALL_MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const curMonthIdx = new Date().getMonth();
const ROLLING_MONTHS = [];
for (let i = 0; i < 12; i++) {
  ROLLING_MONTHS.push(ALL_MONTHS[(curMonthIdx + 1 + i) % 12]);
}

// Seeded pseudo-random activity levels (0 to 4) for realistic UI mockup
const generateMockGrid = () => {
  const grid = [];
  for (let w = 0; w < WEEKS; w++) {
    const week = [];
    const inActiveCluster = (w >= 0 && w <= 10) || (w >= 14 && w <= 22) || (w >= 44 && w <= 52);

    for (let d = 0; d < DAYS; d++) {
      const seed = Math.sin(w * 7.13 + d * 19.87) * 10000;
      const rand = seed - Math.floor(seed);
      let level = 0;

      if (inActiveCluster) {
        if (rand > 0.58) level = 1;
        if (rand > 0.78) level = 2;
        if (rand > 0.91) level = 3;
        if (rand > 0.97) level = 4;
      } else {
        if (rand > 0.85) level = 1;
        if (rand > 0.95) level = 2;
      }
      
      const count = level === 0 ? 0 : level * 2 + Math.floor(rand * 3) + 1;
      week.push({ level, count, weekIndex: w, dayIndex: d });
    }
    grid.push(week);
  }
  return grid;
};

const contributionGrid = generateMockGrid();
---

<!-- GitHub Contribution Activity Dialog -->
<div 
  id="github-modal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-100"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <!-- Backdrop -->
  <div 
    id="github-modal-backdrop"
    class="absolute inset-0 bg-black/40 cursor-pointer"
  ></div>

  <!-- Modal Container -->
  <div 
    id="github-modal-container"
    class="relative w-full max-w-3xl bg-modal-bg border border-border-subtle shadow-2xl p-5 sm:px-7 sm:py-5.5 rounded-none max-h-[92vh] sm:max-h-[95vh] overflow-y-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    <!-- Close button -->
    <button 
      id="github-modal-close-btn"
      class="absolute top-4 right-4 text-text-secondary hover:text-text-primary p-2 font-mono text-xs tracking-wider flex items-center gap-1.5 focus:outline-none transition-colors"
      aria-label="Close activity modal"
    >
      <span class="text-[11px] uppercase font-mono text-text-muted">ESC</span>
      <span class="text-base leading-none">✕</span>
    </button>

    <!-- Modal Header -->
    <div class="border-b border-border-subtle pb-2.5 pr-12">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-2.5">
          <img 
            src="https://github.com/sohamsangole.png?size=72" 
            alt="sohamsangole" 
            class="w-7 h-7 sm:w-8 sm:h-8 rounded-full border border-border-subtle object-cover bg-surface-subtle"
            loading="lazy"
          />
          <h2 class="text-xl sm:text-2xl font-medium tracking-tight text-text-primary">
            sohamsangole
          </h2>
        </div>
        <a 
          href="https://github.com/sohamsangole" 
          target="_blank" 
          rel="noopener noreferrer"
          class="font-mono text-xs text-text-secondary hover:text-text-primary flex items-center gap-1 hover:underline"
        >
          <span>github.com/sohamsangole</span>
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- Quick Stats Row -->
    <div class="grid grid-cols-3 gap-3 py-2.5 border-b border-border-subtle/60 text-xs sm:text-sm font-mono">
      <div class="flex flex-col">
        <span class="text-[10px] uppercase text-text-muted tracking-wider">Activity (1 Year)</span>
        <span id="github-activity-total" class="text-base sm:text-lg font-medium text-text-primary mt-0.5">842 contributions</span>
      </div>
      <div class="flex flex-col">
        <span class="text-[10px] uppercase text-text-muted tracking-wider">Current Streak</span>
        <span id="github-current-streak" class="text-base sm:text-lg font-medium text-text-primary mt-0.5">18 days</span>
      </div>
      <div class="flex flex-col">
        <span class="text-[10px] uppercase text-text-muted tracking-wider">Longest Streak</span>
        <span id="github-longest-streak" class="text-base sm:text-lg font-medium text-text-primary mt-0.5">46 days</span>
      </div>
    </div>

    <!-- Contribution Chart Area -->
    <div class="py-3 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <div class="min-w-[640px]">
        <!-- Month Labels -->
        <div id="github-months-header" class="flex justify-between pl-8 pr-2 pb-1 text-[10px] font-mono text-text-muted select-none">
          {ROLLING_MONTHS.map(m => <span>{m}</span>)}
        </div>

        <!-- Days & Grid Container -->
        <div class="flex gap-2">
          <!-- Day Labels (Mon, Wed, Fri) -->
          <div class="flex flex-col justify-between py-0.5 text-[9px] font-mono text-text-muted w-6 select-none leading-none h-[88px]">
            <span>Mon</span>
            <span>Wed</span>
            <span>Fri</span>
          </div>

          <!-- Heatmap Grid -->
          <div id="github-contributions-grid" class="flex-1 grid grid-flow-col grid-rows-7 gap-[2.5px] p-2 bg-black/[0.02] dark:bg-white/[0.02] border border-border-subtle/50 rounded">
            {contributionGrid.map((week) => (
              week.map((cell) => (
                <div 
                  class={`w-[10px] h-[10px] rounded-[1.5px] cell-level-${cell.level} transition-opacity duration-100 hover:opacity-80 cursor-pointer`}
                  title={`${cell.count} contributions`}
                ></div>
              ))
            ))}
          </div>
        </div>

        <!-- Legend Footer -->
        <div class="flex items-center justify-between mt-2 text-[10px] font-mono text-text-muted select-none">
          <span>Recent repository contributions</span>
          <div class="flex items-center gap-1.5">
            <span>Less</span>
            <span class="w-2.5 h-2.5 cell-level-0 rounded-[1px] inline-block"></span>
            <span class="w-2.5 h-2.5 cell-level-1 rounded-[1px] inline-block"></span>
            <span class="w-2.5 h-2.5 cell-level-2 rounded-[1px] inline-block"></span>
            <span class="w-2.5 h-2.5 cell-level-3 rounded-[1px] inline-block"></span>
            <span class="w-2.5 h-2.5 cell-level-4 rounded-[1px] inline-block"></span>
            <span>More</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Commits Section -->
    <div id="github-recent-commits-section" class="pt-2.5 border-t border-border-subtle flex flex-col space-y-2">
      <div class="flex items-center justify-between text-[11px] font-mono uppercase tracking-wider text-text-secondary select-none">
        <span class="font-medium text-text-primary">RECENT COMMITS</span>
      </div>

      <div id="github-push-events-list" class="flex flex-col space-y-0.5 text-xs font-mono pb-0.5">
        {recentCommits.map((c) => (
          <div class="flex items-center justify-between py-1.5 -mx-2 px-2 rounded hover:bg-black/[0.025] dark:hover:bg-white/[0.03] border-b border-border-subtle/30 last:border-0 text-text-secondary hover:text-text-primary transition-colors gap-3">
            <div class="flex items-baseline gap-2 min-w-0 pr-2">
              <a 
                href={`https://github.com/sohamsangole/${c.repo}`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-medium text-text-primary no-underline hover:underline flex-shrink-0"
              >
                {c.repo}
              </a>
              <span class="text-text-muted text-[10px] select-none flex-shrink-0">/</span>
              <a 
                href={c.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-text-secondary hover:text-text-primary text-[11px] sm:text-xs truncate max-w-[320px] sm:max-w-[440px] no-underline hover:underline" 
                title={c.message}
              >
                {c.message}
              </a>
            </div>
            <span class="text-[11px] text-text-muted flex-shrink-0 font-mono">{c.date}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var hasFetched = false;

    function formatRelativeDate(isoString) {
      try {
        var date = new Date(isoString);
        var now = new Date();
        var diffSec = Math.floor((now - date) / 1000);
        if (diffSec < 60) return 'just now';
        var diffMin = Math.floor(diffSec / 60);
        if (diffMin < 60) return diffMin + 'm ago';
        var diffHours = Math.floor(diffMin / 60);
        if (diffHours < 24) return diffHours + 'h ago';
        var diffDays = Math.floor(diffHours / 24);
        if (diffDays === 1) return 'yesterday';
        if (diffDays < 7) return diffDays + 'd ago';
        return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      } catch (e) {
        return '';
      }
    }

    function fetchLiveGithubData() {
      if (hasFetched) return;
      hasFetched = true;

      var totalEl = document.getElementById('github-activity-total');
      var currentStreakEl = document.getElementById('github-current-streak');
      var longestStreakEl = document.getElementById('github-longest-streak');
      var gridEl = document.getElementById('github-contributions-grid');
      var pushListEl = document.getElementById('github-push-events-list');

      function renderCommits(commits) {
        if (!pushListEl || !commits || commits.length === 0) return;
        pushListEl.innerHTML = '';
        commits.forEach(function(c) {
          var row = document.createElement('div');
          row.className = 'flex items-center justify-between py-1.5 -mx-2 px-2 rounded hover:bg-black/[0.025] dark:hover:bg-white/[0.03] border-b border-border-subtle/30 last:border-0 text-text-secondary hover:text-text-primary transition-colors gap-3';
          row.innerHTML = 
            '<div class="flex items-baseline gap-2 min-w-0 pr-2">' +
              '<a href="https://github.com/sohamsangole/' + c.repo + '" target="_blank" rel="noopener noreferrer" class="font-medium text-text-primary no-underline hover:underline flex-shrink-0">' + c.repo + '</a>' +
              '<span class="text-text-muted text-[10px] select-none flex-shrink-0">/</span>' +
              '<a href="' + c.url + '" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary text-[11px] sm:text-xs truncate max-w-[320px] sm:max-w-[440px] no-underline hover:underline" title="' + c.message.replace(/"/g, '&quot;') + '">' + c.message + '</a>' +
            '</div>' +
            '<span class="text-[11px] text-text-muted flex-shrink-0 font-mono">' + c.date + '</span>';
          pushListEl.appendChild(row);
        });
      }

      // Dynamically fetch recent commits live in the browser (single lightweight request across all public repos)
      if (pushListEl) {
        fetch('https://api.github.com/search/commits?q=author:sohamsangole&sort=author-date&order=desc&per_page=4')
          .then(function(res) {
            if (!res.ok) throw new Error('Search commits failed');
            return res.json();
          })
          .then(function(data) {
            if (!data || !Array.isArray(data.items) || data.items.length === 0) return;
            var commits = data.items.map(function(item) {
              var repoName = item.repository ? item.repository.name : 'portfolio';
              var rawMsg = (item.commit && item.commit.message) ? item.commit.message : '';
              var firstLine = rawMsg.split('\n')[0].trim();
              var shaShort = (item.sha || '').substring(0, 7);
              var dateStr = (item.commit && item.commit.author && item.commit.author.date) || '';
              return {
                repo: repoName,
                message: firstLine || ('Commit ' + shaShort),
                sha: shaShort,
                url: item.html_url || ('https://github.com/sohamsangole/' + repoName + '/commit/' + item.sha),
                date: formatRelativeDate(dateStr)
              };
            });
            renderCommits(commits);
          })
          .catch(function() {
            // Keep pre-rendered commits if search fails or rate limits
          });
      }

      // Fetch contribution activity
      fetch('https://github-contributions-api.jogruber.de/v4/sohamsangole?y=last', { cache: 'no-cache' })
        .then(function(res) {
          if (!res.ok) throw new Error('API error');
          return res.json();
        })
        .then(function(data) {
          if (!data || !data.contributions || !Array.isArray(data.contributions)) return;

          var contributions = data.contributions;
          var totalCount = 0;
          var maxStreak = 0;
          var curStreak = 0;
          var tempStreak = 0;

          for (var i = 0; i < contributions.length; i++) {
            var count = contributions[i].count || 0;
            totalCount += count;
            if (count > 0) {
              tempStreak++;
              if (tempStreak > maxStreak) maxStreak = tempStreak;
            } else {
              tempStreak = 0;
            }
          }

          // Compute current active streak from end backwards
          for (var i = contributions.length - 1; i >= 0; i--) {
            if (contributions[i].count > 0) {
              curStreak++;
            } else if (i === contributions.length - 1) {
              continue;
            } else {
              break;
            }
          }

          if (totalEl) totalEl.textContent = totalCount + ' contributions';
          if (currentStreakEl) currentStreakEl.textContent = curStreak + ' days';
          if (longestStreakEl) longestStreakEl.textContent = maxStreak + ' days';

          // Render live cells with accurate Sunday-to-Saturday row alignment
          if (gridEl && contributions.length > 0) {
            gridEl.innerHTML = '';

            var firstDateStr = contributions[0].date;
            var parts = firstDateStr.split('-');
            var firstDate = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
            var startDay = firstDate.getDay(); // 0 = Sunday

            for (var pad = 0; pad < startDay; pad++) {
              var emptyPad = document.createElement('div');
              emptyPad.className = 'w-[10px] h-[10px] rounded-[1.5px] opacity-0 pointer-events-none';
              gridEl.appendChild(emptyPad);
            }

            contributions.forEach(function(c) {
              var cell = document.createElement('div');
              cell.className = 'w-[10px] h-[10px] rounded-[1.5px] cell-level-' + (c.level || 0) + ' transition-opacity duration-100 hover:opacity-80 cursor-pointer';
              cell.title = c.count + ' contributions on ' + c.date;
              gridEl.appendChild(cell);
            });
          }
        })
        .catch(function() {
          if (statusEl) statusEl.textContent = 'Live Sync (Offline Fallback)';
        });
    }

    function setupGithubModal() {
      var trigger = document.getElementById('activity-modal-trigger');
      var modal = document.getElementById('github-modal');
      var backdrop = document.getElementById('github-modal-backdrop');
      var closeBtn = document.getElementById('github-modal-close-btn');

      function openModal() {
        if (!modal) return;
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100', 'pointer-events-auto');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        fetchLiveGithubData();
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('opacity-100', 'pointer-events-auto');
        modal.classList.add('opacity-0', 'pointer-events-none');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      trigger?.addEventListener('click', function(e) {
        e.preventDefault();
        openModal();
      });

      closeBtn?.addEventListener('click', closeModal);
      backdrop?.addEventListener('click', closeModal);

      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeModal();
        }
      });

      // Background pre-fetch on idle
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(fetchLiveGithubData);
      } else {
        setTimeout(fetchLiveGithubData, 1000);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupGithubModal);
    } else {
      setupGithubModal();
    }
  })();
</script>
