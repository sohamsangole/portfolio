      EMAIL
    </a>

    <a 
      href="#resume" 
      class="hover:text-text-primary transition-colors duration-150 relative py-1 focus:outline-none focus:text-text-primary"
    >
      RESUME
    </a>
  </nav>

  <div class="flex items-center gap-4 text-[10px] text-text-muted tracking-widest">
    <button 
      class="command-palette-trigger hidden sm:inline-flex items-center gap-1 hover:text-text-primary transition-colors duration-150 cursor-pointer focus:outline-none"
      title="Quick Info (⌘K / Ctrl+K)"
      aria-label="Quick Info"
    >
      <span>INFO</span>
      <span class="text-[9px] opacity-70 font-mono">⌘K</span>
    </button>
    <span class="hidden sm:inline">MUMBAI</span>
  </div>
</footer>
