<footer class="w-full flex items-center justify-between text-[11px] sm:text-xs font-mono tracking-widest text-text-secondary pt-2 pb-1 border-t border-border-subtle/50">
  <nav class="flex items-center gap-4 sm:gap-6 flex-wrap">
    <a 
      href="https://github.com/sohamsangole" 
      target="_blank" 
      rel="noopener noreferrer"
      class="hover:text-text-primary transition-colors duration-150 relative py-1 focus:outline-none focus:text-text-primary"
    >
      GITHUB
    </a>
    <a 
      href="https://linkedin.com/in/sohamsangole" 
      target="_blank" 
      rel="noopener noreferrer"
      class="hover:text-text-primary transition-colors duration-150 relative py-1 focus:outline-none focus:text-text-primary"
    >
      LINKEDIN
    </a>
    
    <a 
      href="mailto:sasangole2019@gmail.com?subject=Hello%20Soham%20-%20Let's%20Connect&body=Hi%20Soham%2C%0A%0AI%20came%20across%20your%20portfolio%20and%20wanted%20to%20reach%20out%20regarding%20...%0A%0ABest%2C" 
      class="hover:text-text-primary transition-colors duration-150 py-1 focus:outline-none focus:text-text-primary"
      title="Open email draft"
