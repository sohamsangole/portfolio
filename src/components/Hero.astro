---
import { PORTFOLIO_DATA } from '../data/portfolioData';
---

<section class="w-full flex flex-col justify-center py-1 sm:py-2 md:py-2.5">
  <h1 class="text-3xl sm:text-4xl md:text-[2.85rem] lg:text-[3.1rem] font-medium tracking-tight text-text-primary leading-[1.08]">
    {PORTFOLIO_DATA.hero.title}
  </h1>
  
  <p class="text-sm sm:text-base md:text-[17px] text-text-primary font-normal mt-1.5 sm:mt-2 leading-relaxed max-w-2xl">
    {PORTFOLIO_DATA.hero.subtitle}
  </p>

  <div class="flex items-center gap-3.5 mt-2 sm:mt-2.5 text-xs sm:text-[13px] text-text-secondary">
    <span>{PORTFOLIO_DATA.hero.location}</span>
    <span class="text-border-subtle select-none">/</span>
    <button 
      id="activity-modal-trigger"
      class="group flex items-center gap-2 text-text-secondary hover:text-text-primary transition-colors duration-150 focus:outline-none cursor-pointer py-0.5 px-1 -mx-1 rounded hover:bg-black/[0.03]"
      title="View GitHub contribution activity"
      aria-label="View GitHub contribution chart"
    >
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-600 group-hover:scale-125 transition-transform duration-150"></span>
      <span class="underline decoration-border-subtle group-hover:decoration-text-primary underline-offset-2 transition-colors">{PORTFOLIO_DATA.hero.status}</span>
    </button>
  </div>
</section>
