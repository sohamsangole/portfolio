---
import { PORTFOLIO_DATA } from '../data/portfolioData';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const photoUrl = `${baseUrl}/soham.png`;
---

<section class="w-full flex items-start gap-3.5 sm:gap-4">
  <!-- Avatar Headshot on Left -->
  <div class="relative shrink-0 pt-0.5 group">
    <button
      id="photo-modal-trigger"
      type="button"
      class="block p-0 bg-transparent border-0 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-text-primary rounded-full"
      title="Click to view full photo"
      aria-label="View Soham's photo"
    >
      <div class="relative w-13 h-13 sm:w-14 sm:h-14 rounded-full overflow-hidden ring-1 ring-border-subtle/90 dark:ring-white/15 shadow-sm transition-all duration-300 group-hover:ring-text-primary/40 group-hover:scale-[1.04]">
        <img 
          src={photoUrl} 
          alt="Soham Sangole" 
          width="56"
          height="56"
          class="w-full h-full object-cover grayscale contrast-[1.04] group-hover:grayscale-0 transition-all duration-300 block"
          loading="eager"
        />
      </div>
    </button>
  </div>

  <!-- Text & Status -->
  <div class="flex-1 flex flex-col min-w-0">
    <h1 class="text-xl sm:text-[1.45rem] font-medium tracking-tight text-text-primary leading-tight">
      {PORTFOLIO_DATA.hero.title}
    </h1>
    
    <p class="text-xs sm:text-[12.5px] text-text-secondary font-normal mt-1 leading-relaxed">
      {PORTFOLIO_DATA.hero.subtitle}
    </p>

    <div class="flex items-center mt-2">
      <button 
        id="activity-modal-trigger"
        class="group inline-flex items-center gap-1.5 text-text-secondary hover:text-text-primary transition-colors duration-150 focus:outline-none cursor-pointer py-0.5 px-1 -mx-1 rounded hover:bg-black/[0.04] dark:hover:bg-white/[0.05]"
        title="View GitHub contribution activity"
        aria-label="View GitHub contribution chart"
      >
        <span class="relative flex h-2 w-2 items-center justify-center pointer-events-none">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500/70 opacity-75"></span>
          <span class="relative inline-block w-1.5 h-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400 group-hover:scale-125 transition-transform duration-150"></span>
        </span>
        <span class="underline decoration-border-subtle group-hover:decoration-text-primary underline-offset-2 transition-colors pointer-events-none font-mono text-[10.5px]">{PORTFOLIO_DATA.hero.status}</span>
      </button>
    </div>

  </div>
</section>

<!-- Photo Lightbox Modal -->
<div 
  id="photo-modal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-150"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div 
    id="photo-modal-backdrop"
    class="absolute inset-0 bg-black/60 backdrop-blur-sm cursor-pointer"
  ></div>
  <div 
    class="relative bg-modal-bg border border-border-subtle p-3 rounded-xl shadow-2xl max-w-[340px] w-full flex flex-col items-center"
  >
    <button 
      id="photo-modal-close-btn"
      class="absolute top-2.5 right-2.5 text-text-secondary hover:text-text-primary p-1 font-mono text-xs focus:outline-none transition-colors z-10"
      aria-label="Close photo"
    >
      <span class="text-[10px] uppercase font-mono text-text-muted mr-1">ESC</span>
      <span class="text-sm leading-none">✕</span>
    </button>
    <img 
      src={photoUrl} 
      alt="Soham Sangole" 
      class="max-w-full max-h-[70vh] w-auto h-auto rounded-lg object-contain ring-1 ring-border-subtle block"
    />
  </div>
</div>

<script is:inline>
  (function() {
    function setupPhotoModal() {
      var trigger = document.getElementById('photo-modal-trigger');
      var modal = document.getElementById('photo-modal');
      var backdrop = document.getElementById('photo-modal-backdrop');
      var closeBtn = document.getElementById('photo-modal-close-btn');

      if (!trigger || !modal) return;

      function openModal() {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100', 'pointer-events-auto');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        modal.classList.remove('opacity-100', 'pointer-events-auto');
        modal.classList.add('opacity-0', 'pointer-events-none');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      trigger.onclick = function(e) {
        e.preventDefault();
        openModal();
      };

      if (closeBtn) closeBtn.onclick = closeModal;
      if (backdrop) backdrop.onclick = closeModal;

      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !modal.classList.contains('pointer-events-none')) {
          closeModal();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupPhotoModal);
    } else {
      setupPhotoModal();
    }
  })();
</script>
