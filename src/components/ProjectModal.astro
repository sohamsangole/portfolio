---
import { PORTFOLIO_DATA } from '../data/portfolioData';
---

<!-- Project Detail Dialog -->
<div 
  id="project-modal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-100"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <!-- Backdrop (pure opacity, zero blur overhead for 60-120fps performance) -->
  <div 
    id="modal-backdrop"
    class="absolute inset-0 bg-black/40 cursor-pointer"
  ></div>

  <!-- Modal Container -->
  <div 
    id="modal-container"
    class="relative w-full max-w-2xl bg-modal-bg border border-border-subtle shadow-2xl p-6 sm:p-8 rounded-none overflow-y-auto max-h-[85vh] transition-transform duration-100"
  >
    <!-- Close button -->
    <button 
      id="modal-close-btn"
      class="absolute top-4 right-4 text-text-secondary hover:text-text-primary p-2 font-mono text-xs tracking-wider flex items-center gap-1.5 focus:outline-none transition-colors"
      aria-label="Close modal"
    >
      <span class="text-[11px] uppercase font-mono text-text-muted">ESC</span>
      <span class="text-base leading-none">✕</span>
    </button>

    <!-- Modal Content Dynamically Injected or Swapped -->
    <div id="modal-content" class="flex flex-col space-y-6">
      {PORTFOLIO_DATA.projects.map((proj) => (
        <div id={`modal-detail-${proj.id}`} class="project-detail-view hidden flex-col space-y-5">
          <!-- Header -->
          <div class="border-b border-border-subtle pb-4 pr-12">
            <div class="font-mono text-xs text-text-secondary tracking-widest uppercase mb-1">
              Project {proj.number}
            </div>
            <h2 class="text-xl sm:text-2xl font-medium tracking-tight text-text-primary">
              {proj.title}
            </h2>
            <div class="flex flex-wrap gap-1.5 mt-3">
              {proj.technologies.map((tech) => (
                <span class="font-mono text-[11px] px-2 py-0.5 border border-border-subtle bg-bg/60 text-text-secondary">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Summary -->
          <div class="space-y-2">
            <h4 class="font-mono text-[11px] uppercase tracking-widest text-text-secondary font-medium">
              Overview
            </h4>
            <p class="text-sm text-text-primary leading-relaxed">
              {proj.deepDive.summary}
            </p>
          </div>

          <!-- Highlights -->
          <div class="space-y-2">
            <h4 class="font-mono text-[11px] uppercase tracking-widest text-text-secondary font-medium">
              System Capabilities & Engineering Focus
            </h4>
            <ul class="space-y-1.5 text-xs sm:text-sm text-text-primary">
              {proj.deepDive.highlights.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-text-muted select-none mt-0.5">•</span>
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Architecture -->
          <div class="space-y-2">
            <h4 class="font-mono text-[11px] uppercase tracking-widest text-text-secondary font-medium">
              Architecture & Data Flow
            </h4>
            <ul class="space-y-1.5 text-xs sm:text-sm text-text-secondary font-mono text-[12px]">
              {proj.deepDive.architecture.map((item) => (
                <li class="flex items-start gap-2 bg-black/[0.02] p-2 border border-border-subtle/50">
                  <span class="text-text-muted select-none">›</span>
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Links -->
          {proj.externalUrl && (
            <div class="pt-2 border-t border-border-subtle flex items-center justify-between">
              <span class="text-xs text-text-secondary">Repository Available</span>
              <a 
                href={proj.externalUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 font-mono text-xs text-text-primary hover:text-black border border-text-primary px-3 py-1.5 hover:bg-black hover:text-white transition-all duration-150"
              >
                <span>View on GitHub</span>
                <span>↗</span>
              </a>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  function setupProjectModal() {
    const modal = document.getElementById('project-modal');
    const modalContainer = document.getElementById('modal-container');
    const backdrop = document.getElementById('modal-backdrop');
    const closeBtn = document.getElementById('modal-close-btn');
    const projectRows = document.querySelectorAll('.project-row');
    const detailViews = document.querySelectorAll('.project-detail-view');

    function openModal(projectId: string) {
      if (!modal) return;
      
      // Hide all detail views first
      detailViews.forEach(view => view.classList.add('hidden'));

      // Show selected project view
      const targetView = document.getElementById(`modal-detail-${projectId}`);
      if (targetView) {
        targetView.classList.remove('hidden');
      }

      // Show modal instantaneously
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Attach click listeners to rows
    projectRows.forEach(row => {
      row.addEventListener('click', (e) => {
        // If clicked on external link directly, don't trigger modal
        const target = e.target as HTMLElement;
        if (target.closest('.external-link-btn')) return;

        const projectId = row.getAttribute('data-project-id');
        if (projectId) {
          openModal(projectId);
        }
      });

      row.addEventListener('keydown', (e: Event) => {
        const keyEvent = e as KeyboardEvent;
        if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
          keyEvent.preventDefault();
          const projectId = row.getAttribute('data-project-id');
          if (projectId) openModal(projectId);
        }
      });
    });

    // Close handlers
    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeModal();
      }
    });
  }

  // Initialize on page load and on Astro page swaps if view transitions used
  setupProjectModal();
  document.addEventListener('astro:page-load', setupProjectModal);
</script>
