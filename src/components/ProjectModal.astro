---
import { PORTFOLIO_DATA } from '../data/portfolioData';
---

<!-- Project Detail Dialog -->
<div 
  id="project-modal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-150"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <!-- Backdrop (pure opacity, zero blur overhead for 60-120fps performance) -->
  <div 
    id="modal-backdrop"
    class="absolute inset-0 bg-black/60 cursor-pointer"
  ></div>

  <!-- Modal Container -->
  <div 
    id="modal-container"
    class="relative w-full max-w-2xl bg-modal-bg border border-border-subtle shadow-2xl p-6 sm:p-8 rounded-none overflow-y-auto max-h-[85vh] transition-transform duration-150"
  >
    <!-- Close button -->
    <button 
      id="modal-close-btn"
      class="absolute top-4 right-4 text-text-secondary hover:text-text-primary p-2 font-mono text-xs tracking-wider flex items-center gap-1.5 focus:outline-none transition-colors cursor-pointer"
      aria-label="Close modal"
    >
      <span class="text-[11px] uppercase font-mono text-text-muted">ESC</span>
      <span class="text-base leading-none">✕</span>
    </button>

    <!-- Modal Content Dynamically Injected or Swapped -->
    <div id="modal-content" class="w-full">
      {PORTFOLIO_DATA.projects.map((proj) => (
        <div id={`modal-detail-${proj.id}`} class="project-detail-view hidden flex-col space-y-5">
          <!-- Header -->
          <div class="border-b border-border-subtle pb-4 pr-12">
            <h2 class="text-xl sm:text-2xl font-medium tracking-tight text-text-primary">
              {proj.title}
            </h2>
            <div class="flex flex-wrap items-center gap-1.5 mt-3">
              {proj.externalUrl && (
                <a 
                  href={proj.externalUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 font-mono text-[11px] font-medium bg-black dark:bg-white text-white dark:text-black hover:opacity-85 px-2.5 py-0.5 rounded-sm shadow-sm transition-opacity cursor-pointer select-none"
                  title="Open GitHub repository"
                >
                  <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                  <span>GitHub</span>
                  <span class="text-[10px] leading-none">↗</span>
                </a>
              )}
              {proj.technologies.map((tech) => (
                <span class="font-mono text-[11px] px-2 py-0.5 border border-border-subtle bg-bg/60 text-text-secondary">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Stella Architecture Diagram (Top of Overview, No Box, Just Diagram) -->
          {proj.id === 'stella' && (
            <div class="py-1">
              <div class="pb-1.5 mb-1 border-b border-border-subtle/40 text-[10px] font-mono uppercase text-text-secondary">
                <span>STATE MACHINE WORKFLOW</span>
              </div>
              <svg id="modal-svg-stella" viewBox="0 0 524 94" class="w-full h-auto select-none overflow-visible" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <marker id="modal-arr-mono-stella" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                    <path d="M 0 1 L 5 3 L 0 5 z" class="fill-black/60 dark:fill-white/70" />
                  </marker>
                  <marker id="modal-arr-amber-stella" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                    <path d="M 0 1 L 5 3 L 0 5 z" class="fill-[#D97706] dark:fill-[#FBBF24]" />
                  </marker>
                  <marker id="modal-arr-red-stella" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                    <path d="M 0 1 L 5 3 L 0 5 z" class="fill-[#DC2626] dark:fill-[#F87171]" />
                  </marker>
                </defs>

                <!-- Node 0: GITHUB ISSUE -->
                <rect id="stella-node-issue" x="8" y="8" width="86" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
                <text x="51" y="26" text-anchor="middle" class="font-mono text-[9px] font-medium fill-text-primary tracking-wider">GITHUB ISSUE</text>

                <!-- Arrow 0: GITHUB ISSUE -> PLAN -->
                <line x1="94" y1="22" x2="114" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#modal-arr-mono-stella)"/>

                <!-- Node 1: PLAN -->
                <rect id="stella-node-plan" x="114" y="8" width="58" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
                <text x="143" y="26" text-anchor="middle" class="font-mono text-[10.5px] font-medium fill-text-primary tracking-wider">PLAN</text>

                <!-- Arrow 1: PLAN -> CODE -->
                <line x1="172" y1="22" x2="192" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#modal-arr-mono-stella)"/>

                <!-- Node 2: CODE -->
                <rect id="stella-node-code" x="192" y="8" width="58" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
                <text x="221" y="26" text-anchor="middle" class="font-mono text-[10.5px] font-medium fill-text-primary tracking-wider">CODE</text>

                <!-- Arrow 2: CODE -> REVIEW -->
                <line x1="250" y1="22" x2="270" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#modal-arr-mono-stella)"/>

                <!-- Node 3: REVIEW -->
                <rect id="stella-node-review" x="270" y="8" width="68" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
                <text x="304" y="26" text-anchor="middle" class="font-mono text-[10.5px] font-medium fill-text-primary tracking-wider">REVIEW</text>

                <!-- Arrow 3: REVIEW -> TEST -->
                <line x1="338" y1="22" x2="358" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#modal-arr-mono-stella)"/>

                <!-- Node 4: TEST -->
                <rect id="stella-node-test" x="358" y="8" width="58" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
                <text x="387" y="26" text-anchor="middle" class="font-mono text-[10.5px] font-medium fill-text-primary tracking-wider">TEST</text>

                <!-- Arrow 4: TEST -> PR -->
                <line x1="416" y1="22" x2="436" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#modal-arr-mono-stella)"/>

                <!-- Node 5: PR (Success - Luminous Emerald) -->
                <rect id="stella-node-pr" x="436" y="8" width="80" height="28" rx="4" class="fill-emerald-500/10 dark:fill-emerald-400/15 stroke-emerald-600 dark:stroke-emerald-400" stroke-width="1.3"/>
                <text x="476" y="26" text-anchor="middle" class="font-mono text-[10.5px] font-semibold fill-emerald-600 dark:fill-emerald-300 tracking-wider">PULL REQ ↗</text>

                <!-- Loopback 1: REVIEW Rejected -> PLAN (Luminous Safety Amber) -->
                <path d="M 304 36 v 22 H 154 v -16" fill="none" class="stroke-amber-600 dark:stroke-[#FBBF24]" stroke-width="1.1" stroke-dasharray="2.5 2.5" marker-end="url(#modal-arr-amber-stella)"/>
                <rect id="stella-badge-reject" x="189" y="51" width="80" height="14" rx="3" class="fill-white dark:fill-[#140f06] stroke-amber-500/50 dark:stroke-[#FBBF24]/70" stroke-width="0.8"/>
                <text x="229" y="61.5" text-anchor="middle" class="font-mono text-[7.5px] font-semibold fill-amber-600 dark:fill-[#FDE047] uppercase tracking-tight">review rejected</text>

                <!-- Loopback 2: TEST Failed -> PLAN (Luminous Coral Red) -->
                <path d="M 387 36 v 40 H 132 v -34" fill="none" class="stroke-red-600 dark:stroke-[#F87171]" stroke-width="1.1" stroke-dasharray="2.5 2.5" marker-end="url(#modal-arr-red-stella)"/>
                <rect x="225" y="71" width="70" height="14" rx="3" class="fill-white dark:fill-[#150a0a] stroke-red-500/50 dark:stroke-[#F87171]/70" stroke-width="0.8"/>
                <text x="260" y="81.5" text-anchor="middle" class="font-mono text-[7.5px] font-semibold fill-red-600 dark:fill-[#FCA5A5] uppercase tracking-tight">test failed</text>
              </svg>
            </div>
          )}

          <!-- Payment Platform Architecture Diagram (Top of Overview) -->
          {proj.id === 'payment-platform' && (
            <div class="py-1">
              <div class="pb-1.5 mb-1 border-b border-border-subtle/40 text-[10px] font-mono uppercase text-text-secondary">
                <span>TRANSACTION LIFECYCLE & FRAUD PIPELINE</span>
              </div>
              <svg id="modal-svg-payment" viewBox="0 0 524 94" class="w-full h-auto select-none overflow-visible" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <marker id="modal-arr-mono-pay" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                    <path d="M 0 1 L 5 3 L 0 5 z" class="fill-black/60 dark:fill-white/70" />
                  </marker>
                  <marker id="modal-arr-amber-pay" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                    <path d="M 0 1 L 5 3 L 0 5 z" class="fill-[#D97706] dark:fill-[#FBBF24]" />
                  </marker>
                  <marker id="modal-arr-red-pay" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                    <path d="M 0 1 L 5 3 L 0 5 z" class="fill-[#DC2626] dark:fill-[#F87171]" />
                  </marker>
                </defs>

                <!-- Node 0: INGRESS API -->
                <rect id="pay-node-ingress" x="8" y="8" width="82" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
                <text x="49" y="26" text-anchor="middle" class="font-mono text-[9px] font-medium fill-text-primary tracking-wider">INGRESS API</text>

                <!-- Arrow 0: INGRESS -> IDEMPOTENCY -->
                <line x1="90" y1="22" x2="110" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#modal-arr-mono-pay)"/>

                <!-- Node 1: IDEMPOTENCY / REDIS LOCK -->
                <rect id="pay-node-idempotency" x="110" y="8" width="94" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
                <text x="157" y="26" text-anchor="middle" class="font-mono text-[9px] font-medium fill-text-primary tracking-wider">IDEMPOTENCY</text>

                <!-- Arrow 1: IDEMPOTENCY -> FRAUD -->
                <line x1="204" y1="22" x2="224" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#modal-arr-mono-pay)"/>

                <!-- Node 2: FRAUD SCORE -->
                <rect id="pay-node-fraud" x="224" y="8" width="86" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
                <text x="267" y="26" text-anchor="middle" class="font-mono text-[9.5px] font-medium fill-text-primary tracking-wider">FRAUD EVAL</text>

                <!-- Arrow 2: FRAUD -> DISPATCH -->
                <line x1="310" y1="22" x2="330" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#modal-arr-mono-pay)"/>

                <!-- Node 3: DISPATCH GATEWAY -->
                <rect id="pay-node-dispatch" x="330" y="8" width="70" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
                <text x="365" y="26" text-anchor="middle" class="font-mono text-[9.5px] font-medium fill-text-primary tracking-wider">DISPATCH</text>

                <!-- Arrow 3: DISPATCH -> SETTLED -->
                <line x1="400" y1="22" x2="420" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#modal-arr-mono-pay)"/>

                <!-- Node 4: SETTLED ↗ (Success - Luminous Emerald) -->
                <rect id="pay-node-settled" x="420" y="8" width="96" height="28" rx="4" class="fill-emerald-500/10 dark:fill-emerald-400/15 stroke-emerald-600 dark:stroke-emerald-400" stroke-width="1.3"/>
                <text x="468" y="26" text-anchor="middle" class="font-mono text-[10px] font-semibold fill-emerald-600 dark:fill-emerald-300 tracking-wider">SETTLED ↗</text>

                <!-- Loopback 1: DLQ Rejection (from Fraud Eval - Luminous Coral Red) -->
                <path d="M 267 36 v 22 H 157 v -16" fill="none" class="stroke-red-600 dark:stroke-[#F87171]" stroke-width="1.1" stroke-dasharray="2.5 2.5" marker-end="url(#modal-arr-red-pay)"/>
                <rect id="pay-badge-dlq" x="180" y="51" width="80" height="14" rx="3" class="fill-white dark:fill-[#150a0a] stroke-red-500/50 dark:stroke-[#F87171]/70" stroke-width="0.8"/>
                <text x="220" y="61.5" text-anchor="middle" class="font-mono text-[7.5px] font-semibold fill-red-600 dark:fill-[#FCA5A5] uppercase tracking-tight">dlq / fraud reject</text>

                <!-- Loopback 2: Gateway Retry (from Dispatch - Luminous Safety Amber) -->
                <path d="M 365 36 v 40 H 145 v -34" fill="none" class="stroke-amber-600 dark:stroke-[#FBBF24]" stroke-width="1.1" stroke-dasharray="2.5 2.5" marker-end="url(#modal-arr-amber-pay)"/>
                <rect x="220" y="71" width="84" height="14" rx="3" class="fill-white dark:fill-[#140f06] stroke-amber-500/50 dark:stroke-[#FBBF24]/70" stroke-width="0.8"/>
                <text x="262" y="81.5" text-anchor="middle" class="font-mono text-[7.5px] font-semibold fill-amber-600 dark:fill-[#FDE047] uppercase tracking-tight">backoff retry</text>
              </svg>
            </div>
          )}

          <!-- Summary -->
          <div class="space-y-2">
            <h4 class="font-mono text-[11px] uppercase tracking-widest text-text-secondary font-medium">
              Overview
            </h4>
            <p class="text-sm text-text-primary leading-relaxed">
              {proj.deepDive.summary}
            </p>
          </div>

          <!-- Highlights -->
          <div class="space-y-2">
            <h4 class="font-mono text-[11px] uppercase tracking-widest text-text-secondary font-medium">
              System Capabilities & Engineering Focus
            </h4>
            <ul class="space-y-1.5 text-xs sm:text-sm text-text-primary">
              {proj.deepDive.highlights.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-text-muted select-none mt-0.5">•</span>
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  import { createStellaTelemetry, createPaymentTelemetry, animateModalOpen } from '../scripts/animations';

  function setupProjectModal() {
    const modal = document.getElementById('project-modal');
    const container = document.getElementById('modal-container');
    const backdrop = document.getElementById('modal-backdrop');
    const closeBtn = document.getElementById('modal-close-btn');
    const projectRows = document.querySelectorAll('.project-row');
    const detailViews = document.querySelectorAll('.project-detail-view');

    let activeTl: any = null;

    function openModal(projectId: string) {
      if (!modal) return;

      if (container) container.scrollTop = 0;

      detailViews.forEach(view => view.classList.add('hidden'));

      const targetView = document.getElementById(`modal-detail-${projectId}`);
      if (targetView) {
        targetView.classList.remove('hidden');
      }

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      animateModalOpen(container, backdrop);

      // Start telemetry for the active project diagram
      if (activeTl) {
        activeTl.pause();
        activeTl = null;
      }

      if (projectId === 'stella') {
        const svg = document.getElementById('modal-svg-stella') as SVGSVGElement | null;
        if (svg) activeTl = createStellaTelemetry(svg);
      } else if (projectId === 'payment-platform') {
        const svg = document.getElementById('modal-svg-payment') as SVGSVGElement | null;
        if (svg) activeTl = createPaymentTelemetry(svg);
      }
    }

    function closeModal() {
      if (!modal) return;
      if (activeTl) {
        activeTl.pause();
      }
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    projectRows.forEach(row => {
      row.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.external-link-btn')) return;

        const projectId = row.getAttribute('data-project-id');
        if (projectId) openModal(projectId);
      });

      row.addEventListener('keydown', (e: Event) => {
        const keyEvent = e as KeyboardEvent;
        if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
          keyEvent.preventDefault();
          const projectId = row.getAttribute('data-project-id');
          if (projectId) openModal(projectId);
        }
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  }

  setupProjectModal();
  document.addEventListener('astro:page-load', setupProjectModal);
</script>
