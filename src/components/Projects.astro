---
import { PORTFOLIO_DATA } from '../data/portfolioData';

const paymentProject = PORTFOLIO_DATA.projects.find(p => p.id === 'payment-platform') || PORTFOLIO_DATA.projects[0];
const stellaProject = PORTFOLIO_DATA.projects.find(p => p.id === 'stella') || PORTFOLIO_DATA.projects[1];
---

<section class="w-full flex flex-col relative">
  <div class="flex items-center justify-between mb-3 select-none">
    <span class="text-[10px] uppercase font-mono tracking-widest text-text-muted font-medium">
      FEATURED PROJECTS
    </span>
  </div>

  <div class="flex flex-col space-y-3.5 w-full">
    <!-- Card 1: Payment Processing Platform -->
    <div 
      class="project-row group relative w-full p-4 sm:p-4.5 rounded-xl border border-black/[0.08] dark:border-white/[0.1] bg-black/[0.02] dark:bg-[#080808] hover:bg-black/[0.035] dark:hover:bg-[#0d0d0d] hover:border-black/20 dark:hover:border-white/20 transition-all duration-200 cursor-pointer shadow-sm hover:shadow"
      data-project-id="payment-platform"
      tabindex="0"
      role="button"
      aria-label="View Payment Processing Platform details"
    >
      <div class="flex flex-col space-y-2">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2.5 flex-1 min-w-0">
            <span class="font-mono text-[11px] text-text-muted/70 group-hover:text-text-primary transition-colors select-none font-medium">
              {paymentProject.number}
            </span>
            <h3 class="text-sm sm:text-[15px] font-semibold text-text-primary group-hover:text-black dark:group-hover:text-white transition-colors tracking-tight truncate">
              {paymentProject.title}
            </h3>
          </div>
          <svg class="w-4 h-4 text-text-muted group-hover:text-text-primary transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-150 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </div>

        <p class="text-xs text-text-secondary leading-relaxed font-normal">
          {paymentProject.shortDescription}
        </p>

        <!-- Enlarged Architecture Visual (High-Luminance Cockpit) -->
        <div class="pt-2">
          <svg id="svg-card-payment" viewBox="0 0 524 94" class="w-full h-auto select-none overflow-visible max-h-[105px] sm:max-h-[115px]" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <marker id="arr-mono-pay" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                <path d="M 0 1 L 5 3 L 0 5 z" class="fill-black/60 dark:fill-white/70" />
              </marker>
              <marker id="arr-amber-pay" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                <path d="M 0 1 L 5 3 L 0 5 z" class="fill-[#D97706] dark:fill-[#FBBF24]" />
              </marker>
              <marker id="arr-red-pay" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                <path d="M 0 1 L 5 3 L 0 5 z" class="fill-[#DC2626] dark:fill-[#F87171]" />
              </marker>
            </defs>

            <!-- Node 0: INGRESS API -->
            <rect id="pay-node-ingress" x="8" y="8" width="82" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
            <text x="49" y="26" text-anchor="middle" class="font-mono text-[9px] font-medium fill-text-primary tracking-wider">INGRESS API</text>

            <!-- Arrow 0: INGRESS -> IDEMPOTENCY -->
            <line x1="90" y1="22" x2="110" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#arr-mono-pay)"/>

            <!-- Node 1: IDEMPOTENCY / REDIS LOCK -->
            <rect id="pay-node-idempotency" x="110" y="8" width="94" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
            <text x="157" y="26" text-anchor="middle" class="font-mono text-[9px] font-medium fill-text-primary tracking-wider">IDEMPOTENCY</text>

            <!-- Arrow 1: IDEMPOTENCY -> FRAUD -->
            <line x1="204" y1="22" x2="224" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#arr-mono-pay)"/>

            <!-- Node 2: FRAUD SCORE -->
            <rect id="pay-node-fraud" x="224" y="8" width="86" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
            <text x="267" y="26" text-anchor="middle" class="font-mono text-[9.5px] font-medium fill-text-primary tracking-wider">FRAUD EVAL</text>

            <!-- Arrow 2: FRAUD -> DISPATCH -->
            <line x1="310" y1="22" x2="330" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#arr-mono-pay)"/>

            <!-- Node 3: DISPATCH GATEWAY -->
            <rect id="pay-node-dispatch" x="330" y="8" width="70" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
            <text x="365" y="26" text-anchor="middle" class="font-mono text-[9.5px] font-medium fill-text-primary tracking-wider">DISPATCH</text>

            <!-- Arrow 3: DISPATCH -> SETTLED -->
            <line x1="400" y1="22" x2="420" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#arr-mono-pay)"/>

            <!-- Node 4: SETTLED ↗ (Success - Luminous Emerald) -->
            <rect id="pay-node-settled" x="420" y="8" width="96" height="28" rx="4" class="fill-emerald-500/10 dark:fill-emerald-400/15 stroke-emerald-600 dark:stroke-emerald-400" stroke-width="1.3"/>
            <text x="468" y="26" text-anchor="middle" class="font-mono text-[10px] font-semibold fill-emerald-600 dark:fill-emerald-300 tracking-wider">SETTLED ↗</text>

            <!-- Loopback 1: DLQ Rejection (from Fraud Eval - Luminous Coral Red) -->
            <path d="M 267 36 v 22 H 157 v -16" fill="none" class="stroke-red-600 dark:stroke-[#F87171]" stroke-width="1.1" stroke-dasharray="2.5 2.5" marker-end="url(#arr-red-pay)"/>
            <rect id="pay-badge-dlq" x="180" y="51" width="80" height="14" rx="3" class="fill-white dark:fill-[#150a0a] stroke-red-500/50 dark:stroke-[#F87171]/70" stroke-width="0.8"/>
            <text x="220" y="61.5" text-anchor="middle" class="font-mono text-[7.5px] font-semibold fill-red-600 dark:fill-[#FCA5A5] uppercase tracking-tight">dlq / reject</text>

            <!-- Loopback 2: Gateway Retry (from Dispatch - Luminous Safety Amber) -->
            <path d="M 365 36 v 40 H 145 v -34" fill="none" class="stroke-amber-600 dark:stroke-[#FBBF24]" stroke-width="1.1" stroke-dasharray="2.5 2.5" marker-end="url(#arr-amber-pay)"/>
            <rect x="220" y="71" width="84" height="14" rx="3" class="fill-white dark:fill-[#140f06] stroke-amber-500/50 dark:stroke-[#FBBF24]/70" stroke-width="0.8"/>
            <text x="262" y="81.5" text-anchor="middle" class="font-mono text-[7.5px] font-semibold fill-amber-600 dark:fill-[#FDE047] uppercase tracking-tight">backoff retry</text>
          </svg>
        </div>
      </div>
    </div>

    <!-- Card 2: Stella Automation Platform -->
    <div 
      class="project-row group relative w-full p-4 sm:p-4.5 rounded-xl border border-black/[0.08] dark:border-white/[0.1] bg-black/[0.02] dark:bg-[#080808] hover:bg-black/[0.035] dark:hover:bg-[#0d0d0d] hover:border-black/20 dark:hover:border-white/20 transition-all duration-200 cursor-pointer shadow-sm hover:shadow"
      data-project-id="stella"
      tabindex="0"
      role="button"
      aria-label="View Stella details"
    >
      <div class="flex flex-col space-y-2">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2.5 flex-1 min-w-0">
            <span class="font-mono text-[11px] text-text-muted/70 group-hover:text-text-primary transition-colors select-none font-medium">
              {stellaProject.number}
            </span>
            <h3 class="text-sm sm:text-[15px] font-semibold text-text-primary group-hover:text-black dark:group-hover:text-white transition-colors tracking-tight truncate">
              {stellaProject.title}
            </h3>
          </div>
          <svg class="w-4 h-4 text-text-muted group-hover:text-text-primary transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-150 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </div>

        <p class="text-xs text-text-secondary leading-relaxed font-normal">
          {stellaProject.shortDescription}
        </p>

        <!-- Enlarged Architecture Visual (High-Luminance Cockpit) -->
        <div class="pt-2">
          <svg id="svg-card-stella" viewBox="0 0 524 94" class="w-full h-auto select-none overflow-visible max-h-[105px] sm:max-h-[115px]" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <marker id="arr-mono-stella" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                <path d="M 0 1 L 5 3 L 0 5 z" class="fill-black/60 dark:fill-white/70" />
              </marker>
              <marker id="arr-amber-stella" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                <path d="M 0 1 L 5 3 L 0 5 z" class="fill-[#D97706] dark:fill-[#FBBF24]" />
              </marker>
              <marker id="arr-red-stella" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto">
                <path d="M 0 1 L 5 3 L 0 5 z" class="fill-[#DC2626] dark:fill-[#F87171]" />
              </marker>
            </defs>

            <!-- Node 0: GITHUB ISSUE -->
            <rect id="stella-node-issue" x="8" y="8" width="86" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
            <text x="51" y="26" text-anchor="middle" class="font-mono text-[9px] font-medium fill-text-primary tracking-wider">GITHUB ISSUE</text>

            <!-- Arrow 0: GITHUB ISSUE -> PLAN -->
            <line x1="94" y1="22" x2="114" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#arr-mono-stella)"/>

            <!-- Node 1: PLAN -->
            <rect id="stella-node-plan" x="114" y="8" width="58" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
            <text x="143" y="26" text-anchor="middle" class="font-mono text-[10.5px] font-medium fill-text-primary tracking-wider">PLAN</text>

            <!-- Arrow 1: PLAN -> CODE -->
            <line x1="172" y1="22" x2="192" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#arr-mono-stella)"/>

            <!-- Node 2: CODE -->
            <rect id="stella-node-code" x="192" y="8" width="58" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
            <text x="221" y="26" text-anchor="middle" class="font-mono text-[10.5px] font-medium fill-text-primary tracking-wider">CODE</text>

            <!-- Arrow 2: CODE -> REVIEW -->
            <line x1="250" y1="22" x2="270" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#arr-mono-stella)"/>

            <!-- Node 3: REVIEW -->
            <rect id="stella-node-review" x="270" y="8" width="68" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
            <text x="304" y="26" text-anchor="middle" class="font-mono text-[10.5px] font-medium fill-text-primary tracking-wider">REVIEW</text>

            <!-- Arrow 3: REVIEW -> TEST -->
            <line x1="338" y1="22" x2="358" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#arr-mono-stella)"/>

            <!-- Node 4: TEST -->
            <rect id="stella-node-test" x="358" y="8" width="58" height="28" rx="4" class="fill-white dark:fill-[#121212] stroke-black/25 dark:stroke-white/20" stroke-width="1.2"/>
            <text x="387" y="26" text-anchor="middle" class="font-mono text-[10.5px] font-medium fill-text-primary tracking-wider">TEST</text>

            <!-- Arrow 4: TEST -> PR -->
            <line x1="416" y1="22" x2="436" y2="22" class="stroke-black/50 dark:stroke-white/50" stroke-width="1.3" marker-end="url(#arr-mono-stella)"/>

            <!-- Node 5: PR (Success - Luminous Emerald) -->
            <rect id="stella-node-pr" x="436" y="8" width="80" height="28" rx="4" class="fill-emerald-500/10 dark:fill-emerald-400/15 stroke-emerald-600 dark:stroke-emerald-400" stroke-width="1.3"/>
            <text x="476" y="26" text-anchor="middle" class="font-mono text-[10.5px] font-semibold fill-emerald-600 dark:fill-emerald-300 tracking-wider">PULL REQ ↗</text>

            <!-- Loopback 1: REVIEW Rejected -> PLAN (Luminous Safety Amber) -->
            <path d="M 304 36 v 22 H 154 v -16" fill="none" class="stroke-amber-600 dark:stroke-[#FBBF24]" stroke-width="1.1" stroke-dasharray="2.5 2.5" marker-end="url(#arr-amber-stella)"/>
            <rect id="stella-badge-reject" x="189" y="51" width="80" height="14" rx="3" class="fill-white dark:fill-[#140f06] stroke-amber-500/50 dark:stroke-[#FBBF24]/70" stroke-width="0.8"/>
            <text x="229" y="61.5" text-anchor="middle" class="font-mono text-[7.5px] font-semibold fill-amber-600 dark:fill-[#FDE047] uppercase tracking-tight">review reject</text>

            <!-- Loopback 2: TEST Failed -> PLAN (Luminous Coral Red) -->
            <path d="M 387 36 v 40 H 132 v -34" fill="none" class="stroke-red-600 dark:stroke-[#F87171]" stroke-width="1.1" stroke-dasharray="2.5 2.5" marker-end="url(#arr-red-stella)"/>
            <rect x="225" y="71" width="70" height="14" rx="3" class="fill-white dark:fill-[#150a0a] stroke-red-500/50 dark:stroke-[#F87171]/70" stroke-width="0.8"/>
            <text x="260" y="81.5" text-anchor="middle" class="font-mono text-[7.5px] font-semibold fill-red-600 dark:fill-[#FCA5A5] uppercase tracking-tight">test fail</text>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { createStellaTelemetry, createPaymentTelemetry } from '../scripts/animations';

  function initEmbeddedTelemetry() {
    const svgStella = document.getElementById('svg-card-stella') as SVGSVGElement | null;
    const svgPayment = document.getElementById('svg-card-payment') as SVGSVGElement | null;

    if (svgStella) {
      const stellaTl = createStellaTelemetry(svgStella);
      stellaTl?.play();
    }
    if (svgPayment) {
      const paymentTl = createPaymentTelemetry(svgPayment);
      paymentTl?.play();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEmbeddedTelemetry);
  } else {
    initEmbeddedTelemetry();
  }
  document.addEventListener('astro:page-load', initEmbeddedTelemetry);
</script>

