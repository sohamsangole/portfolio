---
import { PORTFOLIO_DATA } from '../data/portfolioData';
---

<div class="w-full flex flex-col space-y-3.5 sm:space-y-4">
  <!-- Card 1: EXPERIENCE -->
  <div class="w-full p-4 sm:p-4.5 rounded-xl border border-black/[0.08] dark:border-white/[0.1] bg-black/[0.02] dark:bg-[#080808] flex flex-col shadow-sm">
    <div class="text-[9.5px] uppercase font-mono tracking-widest text-text-muted font-medium mb-3 select-none">
      EXPERIENCE
    </div>

    <!-- Vertical Timeline Rail -->
    <div class="relative pl-3.5 border-l border-black/15 dark:border-white/15 space-y-3.5 ml-1.5">
      {PORTFOLIO_DATA.experiences.map((exp) => {
        const isCurrent = exp.period.toLowerCase().includes('present');

        return (
          <div class="relative flex flex-col group">
            <!-- Timeline Node Marker -->
            {isCurrent ? (
              <span class="absolute -left-[18px] top-1.5 flex h-2.5 w-2.5 items-center justify-center">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500/60 opacity-75"></span>
                <span class="relative inline-block w-2 h-2 rounded-full bg-emerald-500 ring-2 ring-white dark:ring-[#080808]"></span>
              </span>
            ) : (
              <span class="absolute -left-[18px] top-1.5 w-2 h-2 rounded-full bg-black/30 dark:bg-white/30 ring-2 ring-white dark:ring-[#080808]"></span>
            )}

            <!-- Header: Company & Period -->
            <div class="flex items-baseline justify-between gap-2">
              <span class="font-medium text-text-primary text-[13px] tracking-tight group-hover:text-black dark:group-hover:text-white transition-colors">
                {exp.company}
              </span>
              <span class={`text-[10px] font-mono tracking-tight ${isCurrent ? 'text-emerald-600 dark:text-emerald-400 font-medium' : 'text-text-muted'}`}>
                {exp.period}
              </span>
            </div>

            <!-- Subheader: Role & Location -->
            <div class="flex items-baseline justify-between text-text-secondary text-[11.5px] mt-1">
              <span>{exp.role}</span>
              {exp.location && (
                <span class="text-[10px] font-mono text-text-muted">{exp.location}</span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Card 2: NOW / ACTIVE FOCUS (Strictly Zero Emojis) -->
  <div class="w-full p-4 sm:p-4.5 rounded-xl border border-black/[0.08] dark:border-white/[0.1] bg-black/[0.02] dark:bg-[#080808] flex flex-col shadow-sm">
    <div class="text-[9.5px] uppercase font-mono tracking-widest text-text-muted font-medium mb-3 select-none">
      NOW
    </div>

    <ul class="flex flex-col space-y-2.5 text-[12px] text-text-secondary">
      {PORTFOLIO_DATA.now.items.map((item) => {
        const isObj = typeof item === 'object' && item !== null;
        const text = isObj ? item.text : item;
        const badge = isObj ? item.badge : null;
        const isSpotify = text.toLowerCase().includes('spotify');

        return (
          <li class="flex items-center gap-2">
            <!-- Clean Micro Engineering Indicator (No Emojis) -->
            {isSpotify ? (
              <span class="flex items-center gap-[2px] h-3 w-3 text-emerald-600 dark:text-emerald-400 shrink-0" aria-label="Audio wave">
                <span class="w-[2px] h-1.5 bg-current rounded-full animate-pulse"></span>
                <span class="w-[2px] h-3 bg-current rounded-full animate-pulse" style="animation-delay: 150ms"></span>
                <span class="w-[2px] h-2 bg-current rounded-full animate-pulse" style="animation-delay: 300ms"></span>
              </span>
            ) : (
              <span class="font-mono text-[10px] text-text-muted select-none shrink-0">&gt;</span>
            )}

            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="text-text-primary/90">{text}</span>
              {badge && (
                <span class="font-mono text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded border border-black/10 dark:border-white/15 bg-black/[0.03] dark:bg-white/[0.05] text-text-muted select-none">
                  {badge}
                </span>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</div>
